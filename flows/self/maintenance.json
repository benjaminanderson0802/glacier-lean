{
  "id": "self-maintenance",
  "name": "Weekly Glacier maintenance proposal",
  "goal": "Check dependencies and the test board, then save one proposal note. This flow never changes the repository.",
  "nodes": [
    {"id": "weekly", "type": "schedule", "config": {"cron": "0 9 * * 1"}, "position": {"x": 0, "y": 0}},
    {"id": "maintenance", "type": "command", "config": {"cmd": "python setup/selfbuild/maintenance.py --repo {repo} --run {run}", "cwd": "{repo}", "timeout": "3600"}, "position": {"x": 300, "y": 0}},
    {"id": "health", "type": "command", "config": {"cmd": "python setup/health_check.py --quick", "cwd": "{repo}", "timeout": "1800"}, "position": {"x": 600, "y": 0}},
    {"id": "scan", "type": "command", "config": {"cmd": "python tools/scan/scan.py", "cwd": "{repo}", "timeout": "120"}, "position": {"x": 900, "y": 0}},
    {"id": "status_note", "type": "note", "config": {"path": "proposals/maintenance-{date}.md", "template": "Weekly maintenance results. This is a proposal for the owner to review. Nothing was installed or changed.\n\n{summary}"}, "position": {"x": 1200, "y": 0}}
  ],
  "edges": [
    {"id": "e0", "source": "weekly", "target": "maintenance", "label": ""},
    {"id": "e1", "source": "maintenance", "target": "health", "label": ""},
    {"id": "e2", "source": "health", "target": "scan", "label": ""},
    {"id": "e3", "source": "scan", "target": "status_note", "label": ""}
  ],
  "max_steps": 10
}
