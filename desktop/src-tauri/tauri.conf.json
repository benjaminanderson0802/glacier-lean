{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glacier",
  "version": "0.1.0",
  "identifier": "org.glacier.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self' http://127.0.0.1:*; script-src 'self'; connect-src ipc: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "icon": [],
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "resources": {
      "../sidecar.json": "sidecar.json",
      "../../glacier/backend/*.py": "backend/",
      "../../glacier/backend/nodes/*.py": "backend/nodes/",
      "../../glacier/backend/routes/*.py": "backend/routes/",
      "../../setup/requirements.txt": "backend/requirements.txt"
    }
  }
}
