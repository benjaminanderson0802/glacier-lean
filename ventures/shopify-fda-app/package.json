{
  "name": "glacier-fda-listing-shopify-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
