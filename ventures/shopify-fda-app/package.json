    "@shopify/app-bridge-react": "4.2.4",
    "@shopify/shopify-app-react-router": "3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "11.0.0",
    "isbot": "5.1.31",
    "prisma": "6.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@shopify/cli": "4.9.3",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "25.5.2",
    "@types/react": "18.3.25",
    "@types/react-dom": "18.3.7",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.4"
  }
