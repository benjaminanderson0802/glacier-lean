{
  "id": "hourly-intake",
  "name": "Warranty registration intake",
  "nodes": [
    {
      "id": "hourly",
      "type": "schedule",
      "config": {
        "cron": "0 * * * *",
        "missed_run": "run_once",
        "overlap": "skip"
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "read_jobber",
      "type": "command",
      "config": {
        "cmd": "python ventures/warranty/scripts/warranty.py jobber-preview",
        "retries": "0",
        "timeout": "120",
        "cwd": "{repo}"
      },
      "position": {
        "x": 280,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "id": "hourly-read",
      "source": "hourly",
      "target": "read_jobber",
      "label": ""
    }
  ]
}
