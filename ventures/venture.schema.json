{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glacier.local/schemas/venture.schema.json",
  "title": "Glacier venture manifest",
  "type": "object",
  "required": ["slug", "name", "flows", "your_steps"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "dry_run_env_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"type": "string", "enum": ["ready", "in_progress", "blocked", "on_hold"]},
    "product": {"type": "object"},
    "blocks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "block_functions": {"type": "array", "items": {"type": "string"}},
    "flows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flow", "cron", "purpose", "missed_run", "overlap"],
        "properties": {
          "flow": {"type": "string"},
          "cron": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "missed_run": {"type": "string", "enum": ["run_once", "skip"]},
          "overlap": {"type": "string", "enum": ["queue", "skip"]}
        },
        "additionalProperties": false
      }
    },
    "secrets_needed": {"type": "array", "items": {"type": "string"}},
    "your_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "when", "detail"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "title": {"type": "string", "minLength": 1},
            "when": {"type": "string", "minLength": 1},
            "detail": {"type": "string", "minLength": 1},
            "instructions": {"type": "string"},
            "links": {"type": "array", "items": {"type": "string", "format": "uri"}},
            "link": {"type": "string", "format": "uri"},
            "secret_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "secrets": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "type": "object", "required": ["name", "label"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
                  "label": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
        },
        "additionalProperties": false
      }
    },
    "launch_gates": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
