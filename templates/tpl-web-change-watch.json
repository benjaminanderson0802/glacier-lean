{
  "id": "tpl-web-change-watch",
  "name": "Watch a web page for changes",
  "description": "Reads one approved page, compares it with the previous saved copy, and records whether it changed.",
  "when_to_use": "Use it for a public page you want to check regularly, such as an announcement or status page.",
  "goal": "Check an approved web page and save a note when its text differs from the last saved copy.",
  "acceptance": [
    {
      "kind": "command",
      "cmd": "find \"$GLACIER_HOME/vault/web-watch\" -type f -name 'run-status-*.md' -mmin -10 -print0 | xargs -0 grep -q ."
    }
  ],
  "nodes": [
    {
      "id": "schedule",
      "type": "schedule",
      "config": {
        "cron": "0 * * * *"
      },
      "position": {
        "x": -260,
        "y": 0
      }
    },
    {
      "id": "read_page",
      "type": "fetch_page",
      "config": {
        "url": "https://example.org/page",
        "allowed_sites": "example.org"
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "save_current",
      "type": "note",
      "config": {
        "path": "web-watch/current-page.md",
        "template": "{prev_output}"
      },
      "position": {
        "x": 260,
        "y": 0
      }
    },
    {
      "id": "compare_page",
      "type": "command",
      "config": {
        "cmd": "if test -f \"$GLACIER_HOME/vault/web-watch/last-page.md\" && cmp -s \"$GLACIER_HOME/vault/web-watch/last-page.md\" \"$GLACIER_HOME/vault/web-watch/current-page.md\"; then printf \"No change\\n\"; else printf \"Page changed\\n\"; fi; cp \"$GLACIER_HOME/vault/web-watch/current-page.md\" \"$GLACIER_HOME/vault/web-watch/last-page.md\"",
        "timeout": "60"
      },
      "position": {
        "x": 520,
        "y": 0
      }
    },
    {
      "id": "status_note",
      "type": "note",
      "config": {
        "path": "web-watch/run-status-{run}.md",
        "template": "The approved page comparison ran.\n\n{prev_output}"
      },
      "position": {
        "x": 780,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "source": "schedule",
      "target": "read_page",
      "label": ""
    },
    {
      "id": "e1",
      "source": "read_page",
      "target": "save_current",
      "label": ""
    },
    {
      "id": "e2",
      "source": "save_current",
      "target": "compare_page",
      "label": ""
    },
    {
      "id": "e3",
      "source": "compare_page",
      "target": "status_note",
      "label": ""
    }
  ]
}
