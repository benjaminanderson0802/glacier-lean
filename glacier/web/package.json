{
  "name": "glacier-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run render:templates",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mock": "node mock/mock_server.mjs",
    "render:templates": "node scripts/render-template-previews.mjs",
    "e2e": "node e2e/core.spec.mjs",
    "check:ui": "node e2e/theme_lint.mjs && node scripts/check-i18n.mjs --fail && tsc -b && npm run render:templates && vite build && node e2e/core.spec.mjs && node e2e/shell.spec.mjs && node e2e/http_step.spec.mjs && node e2e/triggers.spec.mjs && node e2e/spanish.spec.mjs && node e2e/updates.spec.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@assistant-ui/react": "0.15.25",
    "@dagrejs/dagre": "1.1.5",
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/cli": "2.12.1",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2"
  },
  "devDependencies": {
    "@types/dagre": "0.7.52",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "ws": "8.18.3"
  }
}
